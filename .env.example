# Copy this file to `.env` and fill in your own values.

# --- Telegram ---
TELEGRAM_BOT_TOKEN=123456:ABC-DEF...

# --- AI providers (add the ones you use) ---
OPEN_AI_API_KEY=sk-...
ANTHROPIC_API_KEY=sk-ant-...
GOOGLE_AI_API_KEY=...

# --- DynamoDB (session storage) ---
DYNAMODB_REGION=us-east-1
DYNAMODB_ACCESS_KEY=...
DYNAMODB_SECRET_ACCESS_KEY=...
AWS_REGION=us-east-1                 # used by support/video tables
# SUPPORT_TABLE=matt77-support-tickets

# --- Optional integrations ---
BRAVE_API_KEY=...                    # enables brave_web_search
GOOGLE_SERVICE_ACCOUNT_KEY_PATH=./service-account.json   # Google Calendar
GOOGLE_CALENDAR_ID=primary
ADMIN_CHAT_ID=...                    # receives support tickets

# --- Deployment ---
IS_SERVERLESS=                       # set to any value for Lambda mode; leave empty for polling
FUNCTION_URL=                        # public URL when running serverless
